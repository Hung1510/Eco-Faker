{
  "name": "eco-faker-vscode",
  "displayName": "eco-faker",
  "description": "Generate relationally-consistent fake e-commerce datasets, and scaffold a Next.js/MSW integration, without leaving the editor.",
  "version": "0.1.0",
  "publisher": "Hung1510",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Hung1510/Eco-Faker.git",
    "directory": "vscode-extension"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "eco-faker.generateDataset",
        "title": "eco-faker: Generate Dataset"
      },
      {
        "command": "eco-faker.viewDataset",
        "title": "eco-faker: View Dataset Tables"
      },
      {
        "command": "eco-faker.scaffoldNext",
        "title": "eco-faker: Scaffold Next.js Integration (init next)"
      },
      {
        "command": "eco-faker.scaffoldMsw",
        "title": "eco-faker: Scaffold MSW Integration (init msw)"
      }
    ]
  },
  "scripts": {
    "compile": "tsc --noEmit -p tsconfig.json",
    "build": "node esbuild.mjs",
    "test": "node --test dist-test/tests/*.test.js",
    "test:compile": "tsc -p tsconfig.test.json",
    "pretest": "npm run test:compile",
    "package": "npm run build && vsce package"
  },
  "devDependencies": {
    "@types/jsdom": "^28.0.3",
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^2.32.0",
    "esbuild": "^0.24.0",
    "jsdom": "^29.1.1",
    "typescript": "^5.7.0"
  }
}
